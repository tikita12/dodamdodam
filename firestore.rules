rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 지정된 관리자 이메일 인증 검증 함수 (대소문자 무시)
    function isAdmin() {
      return request.auth != null && request.auth.token.email != null &&
        (request.auth.token.email.lower() == "bshine530@gmail.com" || request.auth.token.email.lower() == "cwacc@hanmail.net" || request.auth.token.email.lower() == "admin2@dodam.com");
    }

    // 일정 컬렉션 (/schedules/{scheduleId})
    match /schedules/{scheduleId} {
      allow read: if true;
      allow create: if isAdmin();
      allow delete: if false; // 실제 삭제 방지 (status: 'cancelled' 상태 변경으로 보존)

      // 수정 권한:
      // 1) 관리자는 모든 필드 수정 허용 (확정, 정보 수정, 정원 초과 수동 추가/제거, 취소 등)
      // 2) 비로그인 봉사자: 참여 신청/취소 시 appliedCount (+1 또는 -1) 및 updatedAt(serverTimestamp) 필드만 원자적 갱신 허용
      allow update: if isAdmin() || (
        resource.data.status == 'open'
        && resource.data.startAt > request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['appliedCount', 'updatedAt'])
        && request.resource.data.updatedAt == request.time
        // 신청 (+1): 정원 미만일 때만 허용
        && (
          (request.resource.data.appliedCount == resource.data.appliedCount + 1 
            && resource.data.appliedCount < resource.data.requiredCount
            && request.resource.data.appliedCount <= resource.data.requiredCount)
          ||
          // 취소 (-1): 0 이상일 때만 허용
          (request.resource.data.appliedCount == resource.data.appliedCount - 1 
            && resource.data.appliedCount > 0
            && request.resource.data.appliedCount >= 0)
        )
        // 다른 핵심 메타데이터 불변성 보장
        && request.resource.data.schoolName == resource.data.schoolName
        && request.resource.data.subject == resource.data.subject
        && request.resource.data.startAt == resource.data.startAt
        && request.resource.data.endAt == resource.data.endAt
        && request.resource.data.requiredCount == resource.data.requiredCount
        && request.resource.data.status == resource.data.status
      );
    }

    // 자원봉사자 명단 컬렉션 (/volunteers/{volunteerId})
    match /volunteers/{volunteerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 교육 과목 컬렉션 (/subjects/{subjectId})
    match /subjects/{subjectId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 참여 신청 응답 컬렉션 (/responses/{scheduleId_volunteerId})
    match /responses/{responseDocId} {
      allow read: if true;

      // 생성 권한 (공통 엄격 데이터 무결성 검증):
      // 1) 정확히 4개 필수 필드만 허용
      // 2) 문서 ID 패턴 {scheduleId}_{volunteerId} 일치
      // 3) schedule 및 volunteer 문서 실존 여부 검증
      // 4) volunteerName 위조/오입력 방지: 실제 등록된 봉사자 이름과 스냅샷 이름 100% 일치 강제 (관리자 포함)
      // 5) createdAt == request.time (serverTimestamp 강제)
      // 6) 관리자: 정원 초과(4/3명 등) 수동 추가 허용
      // 7) 일반 봉사자: open 상태, 시작 전, 정원 미달(appliedCount < requiredCount) 강제
      allow create: if request.resource.data.keys().hasOnly(['scheduleId', 'volunteerId', 'volunteerName', 'createdAt'])
        && responseDocId == (request.resource.data.scheduleId + '_' + request.resource.data.volunteerId)
        && request.resource.data.scheduleId is string
        && request.resource.data.volunteerId is string
        && request.resource.data.volunteerName is string
        && request.resource.data.volunteerName.size() > 0
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/schedules/$(request.resource.data.scheduleId))
        && exists(/databases/$(database)/documents/volunteers/$(request.resource.data.volunteerId))
        && request.resource.data.volunteerName == get(/databases/$(database)/documents/volunteers/$(request.resource.data.volunteerId)).data.name
        && (
          isAdmin() || (
            get(/databases/$(database)/documents/schedules/$(request.resource.data.scheduleId)).data.status == 'open'
            && get(/databases/$(database)/documents/schedules/$(request.resource.data.scheduleId)).data.startAt > request.time
            && get(/databases/$(database)/documents/schedules/$(request.resource.data.scheduleId)).data.appliedCount < get(/databases/$(database)/documents/schedules/$(request.resource.data.scheduleId)).data.requiredCount
          )
        );

      // 취소/삭제 권한:
      // 1) 관리자 허용
      // 2) 확정(confirmed)이나 취소(cancelled)되지 않았고 시작 전인 일정에 대한 신청 삭제만 허용
      allow delete: if isAdmin() || (
        exists(/databases/$(database)/documents/schedules/$(resource.data.scheduleId))
        && get(/databases/$(database)/documents/schedules/$(resource.data.scheduleId)).data.status == 'open'
        && get(/databases/$(database)/documents/schedules/$(resource.data.scheduleId)).data.startAt > request.time
      );

      // 응답 문서는 수정 불가 (오직 생성 및 삭제로만 관리)
      allow update: if false;
    }
  }
}
